# DJET Store environment template (copy to .env with chmod 0600; never commit .env)

DJET_ENV=prod
DJANGO_DEBUG=false
# Generate a strong random secret (>= 50 chars): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=replace-with-50-char-random-secret-key-before-running

STORE_DOMAIN=shop.djet.localhost
ADMIN_DOMAIN=admin.djet.localhost
ALLOWED_HOSTS=shop.djet.localhost,admin.djet.localhost
TLS_MODE=internal

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

POSTGRES_DB=djet_store
POSTGRES_USER=djet_migrator
POSTGRES_PASSWORD=replace-with-strong-migrator-password
DJET_APP_DB_PASSWORD=replace-with-strong-app-password
DJET_RO_DB_PASSWORD=replace-with-strong-ro-password

DATABASE_URL=postgresql://djet_app:replace-with-strong-app-password@db:5432/djet_store
MIGRATION_DATABASE_URL=postgresql://djet_migrator:replace-with-strong-migrator-password@db:5432/djet_store

# Generate a Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJET_FIELD_ENCRYPTION_KEY=replace-with-fernet-key

BACKUP_PASSPHRASE=replace-with-restic-passphrase
BACKUP_REPOSITORY=/backups/restic-repo
