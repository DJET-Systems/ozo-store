#!/usr/bin/env bash
# ==============================================================================
# DJET Store — Local Development Server Launcher
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

if [ ! -f .env ]; then
  echo "⚠️ .env file not found. Running initial setup..."
  bin/setup-store --non-interactive
fi

echo "🚀 Starting DJET Store development server on http://localhost:8000/ ..."
echo "   - Storefront:       http://localhost:8000/"
echo "   - Staff Dashboard:  http://localhost:8000/staff/"
echo "   - Electronics Demo: http://localhost:8000/?preset=electronics"
echo "   - Clothing Demo:    http://localhost:8000/?preset=clothing"
echo "   - Food Demo:        http://localhost:8000/?preset=food"
echo "   - Minimarket Demo:  http://localhost:8000/?preset=minimarket"
echo ""

exec uv run python manage.py runserver 0.0.0.0:8000
